    {
      "version": "0.9.22",
      "tag": "v0.9.22",
      "date": "2026-11-13",
      "prerelease": false,
      "groups": [
        {
          "type": "feat",
          "entries": [
            {
              "id": "bcc7f25",
              "scope": "macos",
              "text": "The AppIcon set is now the classic macOS template (824px rounded plate on transparency, deep-space art) so macOS 15 and earlier render a native rounded icon instead of a sharp full-bleed square. Alongside it, AppIcon.icon (Icon Composer, same name as the icon set) carries the full-bleed layered version: macOS 26 uses it and falls back to the set on earlier systems. The pairing and the hand-authored icon.json need the CI build to confirm actool accepts them; if it does not, removing AppIcon.icon restores the classic set alone."
            },
            {
              "id": "54f3987",
              "scope": "macos",
              "text": "Add localized InfoPlist.strings (zh-Hans: 天机云, en: TianjiCloud) and register them in the Xcode project; the bundle stays TianjiCloud.app so packaging and update paths are unchanged."
            }
          ]
        },
        {
          "type": "fix",
          "entries": [
            {
              "id": "703c867",
              "scope": "dashboard",
              "text": "Push the business dashboard content down"
            },
            {
              "id": "97fbea4",
              "scope": "theme",
              "text": "Draw background choices from the raw assets"
            },
            {
              "id": "b79ee73",
              "scope": "macos",
              "text": "default_view must be 'icon-view' (dmgbuild's key); with 'icon' the icon-view settings block, including the background, would have been skipped entirely. Also pin text_size to Finder's 12pt so icon labels land on the plates as measured, and resolve the fallback background path lazily."
            },
            {
              "id": "2b2f0f9",
              "scope": "macos",
              "text": "appdmg writes the installer background as a legacy alias record that current Finder versions no longer resolve, leaving the DMG window plain white even though the image is inside the image file. setup.dart now repackages the built .app with dmgbuild (settings in macos/packaging/dmg/dmgbuild_settings.py, same window, positions and background art) and replaces the distributor's DMG before checksums are generated."
            },
            {
              "id": "ead41c2",
              "scope": "macos",
              "text": "Name the DMG volume in ASCII so Finder shows its background"
            },
            {
              "id": "ef543f9",
              "scope": "macos",
              "text": "Register the Icon Composer icon as a project resource"
            },
            {
              "id": "de03d12",
              "scope": "macos",
              "text": "Let Finder show the localized app name"
            },
            {
              "id": "d722dfb",
              "scope": "macos",
              "text": "The icon artwork floated on transparency, so Launchpad and the apps view padded it with the system grey tile. Bake the brand deep-space background into every icon size so the tile is ours."
            },
            {
              "id": "6820b2f",
              "scope": "macos",
              "text": "Finder draws icon labels black in light appearance and white in dark appearance; on the dark installer background the black labels were unreadable. Semi-transparent plates (measured brightness ~131-137) keep both label colours legible."
            },
            {
              "id": "0f1e016",
              "scope": "macos",
              "text": "Replace the near-white installer background with the dark deep-space design (brand gradient, orbit ring, icon stage glows) so the drag-to-install window matches the app"
            }
          ]
        },
        {
          "type": "perf",
          "entries": [
            {
              "id": "fcbbf49",
              "scope": "theme",
              "text": "Decode background thumbnails at thumbnail size"
            }
          ]
        }
      ]
    },
